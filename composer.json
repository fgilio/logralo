{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fgilio/logralo",
    "type": "project",
    "description": "Daily goals app with streak counter and photo verification.",
    "keywords": [
        "laravel",
        "livewire",
        "goals",
        "streaks"
    ],
    "license": "FSL-1.1-MIT",
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    ],
    "require": {
        "php": "^8.5",
        "aws/aws-sdk-php": "^3.392",
        "intervention/image-laravel": "^4.1",
        "laravel/ai": "^0.10.3",
        "laravel/framework": "^13.8",
        "laravel/nightwatch": "^1.28",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.16",
        "livewire/flux-pro": "^2.16",
        "livewire/livewire": "^4.4",
        "resend/resend-laravel": "^1.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint --parallel",
            "npm run lint"
        ],
        "test:lint": [
            "@php vendor/bin/pint --parallel --test",
            "@php vendor/bin/rector process --dry-run",
            "npm run test:lint"
        ],
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "test:type-coverage": "@php vendor/bin/pest --type-coverage --min=100",
        "test:unit": "@php vendor/bin/pest --parallel",
        "test:unit:full": "@php vendor/bin/pest --parallel --no-tia",
        "test:browser": "@php vendor/bin/pest --testsuite=Browser --no-tia",
        "test:tia-baseline": "@php vendor/bin/pest --parallel --tia --fresh",
        "test": [
            "@test:type-coverage",
            "@test:types",
            "@test:lint",
            "@test:unit",
            "@test:browser"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
