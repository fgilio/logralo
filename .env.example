APP_NAME=Logralo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://logralo.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite locally and in hosted Claude Code sessions; PostgreSQL 18 in CI and on
# PlanetScale in production. Production shares one PlanetScale Postgres cluster
# with jarvis and keeps its own database inside it — see
# docs/architecture/planetscale-shared-cluster.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=logralo
# DB_USERNAME=logralo
# DB_PASSWORD=
# DB_URL=postgresql://logralo.<branch-id>:<password>@<host>:5432/logralo?sslmode=verify-full&sslrootcert=system

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@logralo.fgilio.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production sends through Resend. The name is the one `config/services.php`
# reads, which is also the one resend/resend-laravel expects.
RESEND_API_KEY=

# Goal photos. Local development writes to the `photos` disk under storage/;
# production points this at the Laravel Cloud bucket's disk name.
LOGRALO_PHOTO_DISK=photos
# A private bucket needs signed URLs. Each signature is cached for three
# quarters of its life so the feed keeps hitting the browser cache.
LOGRALO_PHOTO_SIGNED_URLS=false
# Uploads are decoded from the local filesystem before being stored, so the
# Livewire temp disk stays local even when the photo disk is a bucket.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
# Intervention driver. GD is the safe default; the Imagick driver is the only
# one that can read a HEIC, and only where ImageMagick has libheif.
# IMAGE_DRIVER="Intervention\Image\Drivers\Imagick\Driver"

# Profile pictures. A member's own upload wins; failing that the browser tries
# the Gravatar their email already has, and initials are what shows when
# neither exists. Off leaves uploads and initials.
LOGRALO_GRAVATAR=true

# A member's day D accepts marks until D+1 at this hour, in their own timezone.
LOGRALO_GRACE_CUTOFF_HOUR=12
LOGRALO_DEFAULT_TIMEZONE=America/Montevideo
LOGRALO_MAGIC_LINK_TTL_DAYS=14

# Nightwatch (Franco's personal account).
NIGHTWATCH_TOKEN=

VITE_APP_NAME="${APP_NAME}"
